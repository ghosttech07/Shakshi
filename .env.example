# Deploying on Vercel? See DEPLOY.md: the same names go in each Vercel project's Environment Variables.
# Shakshi runs as two apps. Each reads its own .env.local:
#   backend/.env.local   (API, database, studio)      port 4000
#   frontend/.env.local  (the storefront)             port 3000
# `npm run studio:setup` writes both files for you with fresh secrets.

# ───────────────────────── backend/.env.local ─────────────────────────

# Studio (admin) access. The studio lives at http://<backend>/<ADMIN_PATH> (default: /admin).
# ADMIN_PASSWORD_HASH is a bcrypt hash; the password itself is never stored.
ADMIN_PATH=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=        # 32+ random characters

# Where the storefront runs, and the shared secret it uses to refresh pages after a publish.
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=

# Supabase (optional). Without both values, data is kept in backend/.data/db.json (local use only).
# Run backend/supabase/migrations/*.sql in the Supabase SQL editor first.
# Use the SECRET (service role) key; it stays on the server. The publishable key isn't needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the AI Sleep Concierge (falls back to a built-in guide when unset).
ANTHROPIC_API_KEY=

# Optional: video consultations get a room at this address + a random name.
VIDEO_ROOM_BASE=https://meet.jit.si/

# Sample "someone just chose…" notices when there are no real recent orders. Keep false in production.
SOCIAL_PROOF_DEMO=false

# ───────────────────────── frontend/.env.local ─────────────────────────

# The backend's address. Browser calls to /api/* are forwarded there.
API_URL=http://localhost:4000
REVALIDATE_SECRET=           # same value as the backend's
# Where /admin on the shop sends people (defaults to API_URL + /admin).
STUDIO_URL=
# The studio's origin, allowed to frame /preview (defaults to API_URL's origin).
STUDIO_ORIGIN=
# Public site address, used for canonical URLs, the sitemap, referral and gift links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: a default unboxing film for the setup guide (can also be set per page in the studio).
NEXT_PUBLIC_UNBOXING_VIDEO_URL=
