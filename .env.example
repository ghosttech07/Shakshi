# Optional: enables the AI Sleep Concierge (falls back to a built-in guide when unset)
ANTHROPIC_API_KEY=

# Optional: Supabase. Without these, data is kept in .data/db.json (fine for local use only).
# Run supabase/migrations/0001_init.sql in your project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required for /admin. Pick a long random value.
ADMIN_PASSWORD=

# Public site address, used for canonical URLs, sitemap, referral and gift links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows sample "someone just chose…" notices when there are no real recent orders.
# Keep false in production: social proof must reflect real purchases.
SOCIAL_PROOF_DEMO=false

# Optional: an unboxing film for the setup guide (mp4/webm URL)
NEXT_PUBLIC_UNBOXING_VIDEO_URL=
